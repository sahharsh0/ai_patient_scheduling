# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file.

APP_NAME=SmartCare AI
ENV=development
DEBUG=true

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartcare_ai
DB_USER=smartcare
DB_PASSWORD=smartcare_dev_pw

# --- JWT ---
# In production this MUST be a strong, unique, randomly generated secret
# (32+ characters). The app refuses to start with the placeholder below when
# ENV=production — see app/core/config.py:validate_production_safety.
JWT_SECRET_KEY=CHANGE_ME_DEV_ONLY_INSECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins. For production, include
# your deployed Vercel frontend URL, e.g.:
# CORS_ALLOWED_ORIGINS=https://smartcare.vercel.app,https://smartcare-staging.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI provider ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- ML ---
# Directory containing duration_model.joblib, noshow_model.joblib,
# feature_names.json, and categorical_maps.json. Relative paths resolve
# against the backend project root.
ML_MODEL_DIR=app/ml/models

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
